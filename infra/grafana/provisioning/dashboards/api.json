{
  "title": "QuoteIQ API",
  "uid": "quoteiq-api",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "targets": [{ "expr": "sum(rate(quoteiq_http_requests_total[5m]))" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP latency",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(quoteiq_http_request_seconds_bucket[5m])) by (le))" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    }
  ]
}
