# Copy to .env and replace every secret before running outside a local machine.
# Never commit the filled .env file.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://quoteiq:quoteiq@localhost:5432/quoteiq
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-string
JWT_EXP_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

STORAGE_BACKEND=local
STORAGE_DIR=./storage
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_BUCKET=quoteiq
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# true runs drawing analysis in the API process after the response is prepared.
# Docker Compose sets this false and uses the Celery worker.
PROCESS_INLINE=true
PROCESS_SYNC=false
MAX_UPLOAD_MB=25

MODEL_ARTIFACT_DIR=./ml/artifacts
MLFLOW_TRACKING_URI=http://localhost:5000
CONFIDENCE_REVIEW_THRESHOLD=0.75

POSTGRES_USER=quoteiq
POSTGRES_PASSWORD=quoteiq
POSTGRES_DB=quoteiq
NEXT_PUBLIC_API_URL=http://localhost:8000

AIRFLOW_USER=admin
AIRFLOW_PASSWORD=change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
